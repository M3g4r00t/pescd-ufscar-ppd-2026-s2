{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ica": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ICA Models",
      "options": {
        "baseURL": "https://api.servicesessentials.ibm.com/v1",
        "apiKey": "sk-dbULUE1zso8UfZ5lZMYuag"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT Luna v5.6 (IBM ICA)"
        },
        "gpt-5.6-terra": {
          "name": "GPT Terra v5.6 (IBM ICA)"
        },
        "gpt-5.6-sol": {
          "name": "GPT Sol v5.6 (IBM ICA)"
        }
      }
    }
  },
  "model": "ica/gpt-5.6-luna",
  "autoupdate": true,
  "plugin": [],
  "instructions": [
    "AGENTS.md",
    "OPENCODE.md"
  ],
  "agent": {

      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "ica": {
      "type": "local",
      "command": [
        "node",
        "/home/dennys/WindowsD/Projects/mcp-ica-2.0-server/dist/server.js"
      ],
      "environment": {
        "ICA_API_KEY": "sk-5f95b98f489a4c4da6c5f0de7bb24d94"
      },
      "timeout": 360000
    }
  },
  "command": {},
  "formatter": {},
  "permission": {
    "*": "allow"
  }
}